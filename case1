<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Malla Reddy University | Student Helpdesk & Circular Portal</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header Section -->
    <header>
        <div class="container header-content">
            <h1>Malla Reddy University</h1>
            <p>Student Helpdesk &amp; Circular Portal</p>
        </div>
    </header>

    <!-- Navigation Bar -->
    <nav aria-label="Main Navigation">
        <div class="container">
            <ul>
                <li><a href="#circulars">Circulars &amp; Notices</a></li>
                <li><a href="#campus">Campus Highlights</a></li>
                <li><a href="#resources">Downloads &amp; Links</a></li>
                <li><a href="#enquiry">Student Enquiry</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="container">
        
        <!-- Circulars & Examination Notifications -->
        <section id="circulars" class="card-section">
            <h2>Academic Circulars &amp; Exam Notifications</h2>
            <div class="grid-container">
                <article class="notice-card">
                    <span class="badge exam">Exam Notification</span>
                    <h3>B.Tech Semester End Examination Schedule</h3>
                    <p class="date">Published: November 18, 2026</p>
                    <p>Timetable for all B.Tech II, III, and IV Year regular and supplementary examinations has been released.</p>
                </article>

                <article class="notice-card">
                    <span class="badge academic">Academic Circular</span>
                    <h3>Course Registration for Even Semester</h3>
                    <p class="date">Published: November 15, 2026</p>
                    <p>Students are advised to complete their elective subject registration before the deadline without late fees.</p>
                </article>

                <article class="notice-card">
                    <span class="badge campus">Announcement</span>
                    <h3>Annual Tech Fest &amp; Hackathon 2026</h3>
                    <p class="date">Published: November 10, 2026</p>
                    <p>Registrations are now open for inter-departmental coding challenges and project expos.</p>
                </article>
            </div>
        </section>

        <!-- Campus Announcements / Images -->
        <section id="campus" class="card-section">
            <h2>Campus Announcements &amp; Gallery</h2>
            <div class="grid-container">
                <figure class="gallery-item">
                    <img src="https://placehold.co" alt="University Central Library">
                    <figcaption>Central Library extended hours during examination weeks (8:00 AM – 10:00 PM).</figcaption>
                </figure>
                <figure class="gallery-item">
                    <img src="https://placehold.co" alt="Student Innovation Lab">
                    <figcaption>New AI &amp; Robotics Lab inaugurated in Block B for student research projects.</figcaption>
                </figure>
            </div>
        </section>

        <!-- Important Links & Downloadable Resources -->
        <div class="two-column">
            <section id="resources" class="card-section">
                <h2>Downloadable Resources</h2>
                <ul class="resource-list">
                    <li><a href="files/academic-calendar-2026.pdf" download>📄 Academic Calendar 2026–27 (PDF)</a></li>
                    <li><a href="files/exam-hall-ticket-guidelines.pdf" download>📄 Examination Hall Ticket Guidelines (PDF)</a></li>
                    <li><a href="files/bonafide-application-form.pdf" download>📄 Bonafide Certificate Application Form (PDF)</a></li>
                    <li><a href="files/scholarship-checklist.pdf" download>📄 Student Scholarship Checklist (PDF)</a></li>
                </ul>
            </section>

            <aside class="card-section">
                <h2>Important Quick Links</h2>
                <ul class="resource-list">
                    <li><a href="https://mallareddyuniversity.ac.in" target="_blank" rel="noopener">🌐 Official University Website</a></li>
                    <li><a href="#results">📊 Student Examination Results Portal</a></li>
                    <li><a href="#lms">💻 Learning Management System (LMS)</a></li>
                    <li><a href="#transport">🚌 Campus Transport &amp; Bus Routes</a></li>
                </ul>
            </aside>
        </div>

        <!-- Student Enquiry Form -->
        <section id="enquiry" class="card-section">
            <h2>Student Helpdesk Enquiry Form</h2>
            <p>Have a question regarding exams, certificates, or fees? Submit your query below.</p>
            
            <form action="#" method="post" class="enquiry-form">
                <div class="form-group">
                    <label for="full-name">Full Name *</label>
                    <input type="text" id="full-name" name="full_name" placeholder="Enter your full name" required>
                </div>

                <div class="form-group">
                    <label for="roll-number">Roll Number *</label>
                    <input type="text" id="roll-number" name="roll_number" placeholder="e.g., 2311CS010001" required>
                </div>

                <div class="form-group">
                    <label for="email">University Email *</label>
                    <input type="email" id="email" name="email" placeholder="student@mallareddyuniversity.ac.in" required>
                </div>

                <div class="form-group">
                    <label for="department">Department *</label>
                    <select id="department" name="department" required>
                        <option value="">-- Select Department --</option>
                        <option value="cse">Computer Science &amp; Engineering (CSE)</option>
                        <option value="aiml">AI &amp; Machine Learning</option>
                        <option value="ece">Electronics &amp; Communication (ECE)</option>
                        <option value="management">School of Management</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="category">Query Category *</label>
                    <select id="category" name="category" required>
                        <option value="">-- Select Issue Type --</option>
                        <option value="exams">Examinations &amp; Hall Tickets</option>
                        <option value="certificates">Certificates &amp; Transcripts</option>
                        <option value="fees">Fee &amp; Scholarship</option>
                        <option value="general">General Helpdesk</option>
                    </select>
                </div>

                <div class="form-group full-width">
                    <label for="message">Describe Your Query *</label>
                    <textarea id="message" name="message" rows="4" placeholder="Write your message clearly..." required></textarea>
                </div>

                <div class="form-actions full-width">
                    <button type="submit" class="btn-submit">Submit Enquiry</button>
                    <button type="reset" class="btn-reset">Clear Form</button>
                </div>
            </form>
        </section>

    </main>

    <!-- Footer Section -->
    <footer id="contact">
        <div class="container footer-content">
            <div>
                <h3>Contact Student Helpdesk</h3>
                <p>Maisammaguda, Dulapally, Hyderabad, Telangana 500100</p>
                <p>Email: helpdesk@mallareddyuniversity.ac.in | Phone: +91 40 2379 2146</p>
            </div>
            <p class="copyright">&copy; 2026 Malla Reddy University. All Rights Reserved.</p>
        </div>
    </footer>

</body>
</html>
